# Copie para .env (ignorado pelo Git) e preencha com as suas credenciais.

# Roboflow: Settings > API Keys > Private API Key
ROBOFLOW_API_KEY=

# Kaggle: https://www.kaggle.com/settings/api > Generate New Token
# Alternativa sem token em arquivo: rode `kaggle auth login` uma vez no terminal.
KAGGLE_API_TOKEN=
